<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ArcSperanzaIntel.App.Controls"
        xmlns:l="using:ArcSperanzaIntel.App.Localization"
        xmlns:vm="using:ArcSperanzaIntel.App.ViewModels"
        xmlns:views="using:ArcSperanzaIntel.App.Views"
        xmlns:icons="using:ArcSperanzaIntel.App.Icons"
        x:Class="ArcSperanzaIntel.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ARC Speranza Intel"
        Icon="/Assets/app.ico"
        Width="1500" Height="920" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <!-- wąskie okno: zakładki same ikony (podpis w dymku), przy bardzo wąskim także bez napisu przy logo -->
    <Style Selector="Window.compact TextBlock.tablabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.compact Button.tab">
      <Setter Property="Padding" Value="11,0" />
    </Style>
    <Style Selector="Window.narrow TextBlock.logotext">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- przyciski okna w naszym pasku (─ ▢ ✕) zamiast paska Windows -->
    <Style Selector="Button.winbtn">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource ArcMuted}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.winbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ArcHover}" />
      <Setter Property="Foreground" Value="{StaticResource ArcText}" />
    </Style>
    <Style Selector="Button.winbtn.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.winbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ArcLine2}" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid" RowDefinitions="52,*,26">

    <!-- ====================================================== GÓRNY PASEK (= pasek okna: przeciąganie, dwuklik) -->
    <Border x:Name="TitleBar" Grid.Row="0" Classes="panel" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <StackPanel x:Name="LogoPanel" Orientation="Horizontal" Spacing="10" Margin="18,0" VerticalAlignment="Center">
          <c:AppLogo Height="24" VerticalAlignment="Center" />
          <TextBlock Classes="logotext" Text="ARC" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="20" LetterSpacing="2"
                     VerticalAlignment="Center" />
          <TextBlock Classes="logotext" Text="SPERANZA INTEL" FontFamily="{StaticResource HeadFont}" FontWeight="SemiBold" FontSize="20" LetterSpacing="2"
                     Foreground="{StaticResource ArcYellow}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="TabsPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Classes="tab" ToolTip.Tip="{l:T TabMaps}" Classes.active="{Binding IsMapsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Maps">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <PathIcon Data="{x:Static icons:UiIcons.Map}" Width="16" Height="16" />
                <TextBlock Classes="tablabel" Text="{l:T TabMaps}" VerticalAlignment="Center" LetterSpacing="1.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="tab" ToolTip.Tip="{l:T TabQuests}" Classes.active="{Binding IsQuestsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Quests">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <PathIcon Data="{x:Static icons:UiIcons.Quests}" Width="16" Height="16" />
                <TextBlock Classes="tablabel" Text="{l:T TabQuests}" VerticalAlignment="Center" LetterSpacing="1.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="tab" ToolTip.Tip="{l:T TabItems}" Classes.active="{Binding IsItemsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Items">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <PathIcon Data="{x:Static icons:UiIcons.Items}" Width="16" Height="16" />
                <TextBlock Classes="tablabel" Text="{l:T TabItems}" VerticalAlignment="Center" LetterSpacing="1.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="tab" ToolTip.Tip="{l:T TabTraders}" Classes.active="{Binding IsShopsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Shops">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <PathIcon Data="{x:Static icons:UiIcons.Shops}" Width="16" Height="16" />
                <TextBlock Classes="tablabel" Text="{l:T TabTraders}" VerticalAlignment="Center" LetterSpacing="1.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="tab" ToolTip.Tip="{l:T TabWorkshop}" Classes.active="{Binding IsWorkshopTab}" Command="{Binding SelectTabCommand}" CommandParameter="Workshop">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <PathIcon Data="{x:Static icons:UiIcons.Workshop}" Width="16" Height="16" />
                <TextBlock Classes="tablabel" Text="{l:T TabWorkshop}" VerticalAlignment="Center" LetterSpacing="1.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="tab" ToolTip.Tip="{l:T EventsTitle}" Classes.active="{Binding IsEventsTab}" Command="{Binding SelectTabCommand}" CommandParameter="Events">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <PathIcon Data="{x:Static icons:UiIcons.Events}" Width="16" Height="16" />
                <TextBlock Classes="tablabel" Text="{l:T EventsTitle}" VerticalAlignment="Center" LetterSpacing="1.5" />
              </StackPanel>
            </Panel>
          </Button>
        </StackPanel>

        <StackPanel x:Name="RightPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
          <Button Classes="tab round" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{l:T NavBack}">
            <Panel>
              <PathIcon Data="{x:Static icons:UiIcons.Back}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Button>
          <Button Classes="tab round" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="{l:T NavForward}">
            <Panel>
              <PathIcon Data="{x:Static icons:UiIcons.Forward}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Button>
          <Button Classes="tab round" Classes.active="{Binding IsSettingsTab}" Margin="8,0,0,0"
                  Command="{Binding SelectTabCommand}" CommandParameter="Settings" ToolTip.Tip="{l:T Settings}">
            <Panel>
              <PathIcon Data="{x:Static icons:UiIcons.Settings}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Button>
        </StackPanel>

        <StackPanel x:Name="WindowButtons" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Classes="winbtn" Click="OnMinimize" ToolTip.Tip="{l:T WinMinimize}">
            <Path Data="M0,5 L10,5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Width="10" Height="10" />
          </Button>
          <Button Classes="winbtn" Click="OnMaximize" ToolTip.Tip="{l:T WinMaximize}">
            <Path x:Name="MaxIcon" Data="M0.6,0.6 L9.4,0.6 L9.4,9.4 L0.6,9.4 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
          <Button Classes="winbtn close" Click="OnClose" ToolTip.Tip="{l:T WinClose}">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Width="10" Height="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ====================================================== ZAKŁADKI -->
    <c:Backdrop Grid.Row="1" />
    <Panel Grid.Row="1" x:Name="TabHost" ClipToBounds="True">
      <Panel IsVisible="{Binding IsMapsTab}">
        <views:MapsView DataContext="{Binding Maps}" />
      </Panel>
      <Panel IsVisible="{Binding IsQuestsTab}">
        <views:QuestsView DataContext="{Binding Quests}" />
      </Panel>
      <Panel IsVisible="{Binding IsItemsTab}">
        <views:ItemsView DataContext="{Binding Items}" />
      </Panel>
      <Panel IsVisible="{Binding IsShopsTab}">
        <views:ShopsView DataContext="{Binding Shops}" />
      </Panel>
      <Panel IsVisible="{Binding IsWorkshopTab}">
        <views:WorkshopView DataContext="{Binding Workshop}" />
      </Panel>
      <Panel IsVisible="{Binding IsEventsTab}">
        <views:EventsView DataContext="{Binding Events}" />
      </Panel>
      <Panel IsVisible="{Binding IsSettingsTab}">
        <views:SettingsView DataContext="{Binding Settings}" />
      </Panel>

      <!-- ładowanie -->
      <Border Background="{StaticResource ArcBlack}" IsVisible="{Binding IsLoading}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="520">
          <c:AppLogo Height="44" VerticalAlignment="Center" HorizontalAlignment="Center" />
          <TextBlock Text="ARC SPERANZA INTEL" Classes="h1" HorizontalAlignment="Center" LetterSpacing="3" />
          <ProgressBar IsIndeterminate="True" Width="260" Height="3" Foreground="{StaticResource ArcYellow}" />
          <TextBlock Text="{Binding LoadingText}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- toasty -->
      <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                    IsHitTestVisible="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToastViewModel">
            <Border Classes="overlay" Margin="0,4,0,0" Padding="0" HorizontalAlignment="Center">
              <Grid ColumnDefinitions="4,*">
                <Border Background="{Binding Accent}" CornerRadius="3,0,0,3" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="14,10" MaxWidth="560" TextWrapping="Wrap" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- okno dialogowe -->
      <Border Background="#B3000000" IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Classes="overlay" Width="460" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                DataContext="{Binding Dialog}" x:DataType="vm:DialogViewModel">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding Title}" Classes="h2" />
            <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
            <TextBox x:Name="DialogInput" Text="{Binding InputText}" IsVisible="{Binding HasInput}" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="70" MaxHeight="200" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
              <Button Classes="ghost" Content="{l:T Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
              <Button Classes="primary" Classes.danger="{Binding IsDanger}" Content="{Binding ConfirmText}"
                      Command="{Binding ConfirmCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Panel>

    <!-- ====================================================== PASEK STANU -->
    <Border Grid.Row="2" Classes="panel" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0">
        <TextBlock Text="{Binding StatusText}" Classes="dim small" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{l:T FooterData}" Classes="dim small" VerticalAlignment="Center" />
          <Button Classes="flat" Padding="4,1" FontSize="12" Foreground="{StaticResource ArcYellow}" Content="MetaForge"
                  Command="{Binding OpenMetaForgeCommand}" />
          <TextBlock Text="{l:T FooterRest}"
                     Classes="dim small" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
