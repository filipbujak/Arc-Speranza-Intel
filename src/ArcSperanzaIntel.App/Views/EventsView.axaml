<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ArcSperanzaIntel.App.Localization"
             xmlns:vm="using:ArcSperanzaIntel.App.ViewModels"
             xmlns:icons="using:ArcSperanzaIntel.App.Icons"
             xmlns:c="using:ArcSperanzaIntel.App.Controls"
             x:Class="ArcSperanzaIntel.App.Views.EventsView"
             x:DataType="vm:EventsViewModel">

  <UserControl.Styles>
    <Style Selector="Button.evchip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{StaticResource ArcText}" />
    </Style>
    <Style Selector="Button.evchip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.evchip:pointerover > Border">
      <Setter Property="BorderThickness" Value="3,1,1,1" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="290,*">

    <!-- ====================================================== FILTR MAP -->
    <Border Classes="panel" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="16,16,16,8" Spacing="6">
          <TextBlock Text="{l:T EventsTitle}" Classes="label" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,0,8" Spacing="2">
            <TextBlock Text="{l:T MapsFilterTitle}" Classes="label" Margin="16,4,0,4" />
            <ItemsControl ItemsSource="{Binding MapFilters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EventMapFilterViewModel">
                  <Button Classes="navrow" Classes.active="{Binding IsActive}" Command="{Binding SelectCommand}">
                    <Grid ColumnDefinitions="3,*">
                      <Border Classes="navbar" IsVisible="{Binding IsActive}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{l:T ModesTitle}" Classes="label" Margin="16,14,0,4" />
            <ItemsControl ItemsSource="{Binding ModeFilters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EventModeFilterViewModel">
                  <Button Classes="navrow" Classes.active="{Binding IsActive}" Command="{Binding SelectCommand}">
                    <Grid ColumnDefinitions="3,Auto,*">
                      <Border Classes="navbar" IsVisible="{Binding IsActive}" />
                      <!-- ikony wydarzeń są okrągłe — okrągła oprawka w kolorze wydarzenia zamiast kwadratu -->
                      <Border Grid.Column="1" Width="32" Height="32" Margin="9,0,0,0" Background="{StaticResource ArcBlack}" CornerRadius="16"
                              BorderBrush="{Binding Accent}" BorderThickness="1.5" ClipToBounds="True"
                              IsVisible="{Binding HasIcon}" VerticalAlignment="Center">
                        <c:RemoteImage Url="{Binding IconUrl}" DecodeWidth="64" />
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasInfo}">
                          <Ellipse Width="6" Height="6" Fill="{StaticResource ArcRed}" IsVisible="{Binding IsLive}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Info}" Classes="dim small" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="16,8,16,16" Spacing="8">
          <Button Classes="ghost" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsRefreshing}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static icons:UiIcons.Refresh}" Width="13" Height="13" />
              <TextBlock Text="{l:T EventsRefresh}" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding SourceText}" Classes="dim small" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ====================================================== ROZKŁAD: MAPY × GODZINY -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="22,16,22,16">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="{l:T EventsTitle}" Classes="h1" LetterSpacing="2" VerticalAlignment="Center" />
          <Border Background="#2A1210" BorderBrush="#5A231C" BorderThickness="1" CornerRadius="14" Padding="10,4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="{StaticResource ArcRed}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding NowText}" Foreground="#FF8A7A" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{l:T EventsNoData}" Classes="muted" IsVisible="{Binding NoData}" Margin="16,0" VerticalAlignment="Center" />
        <!-- strony godzin -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="tab round" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanPrevPage}" ToolTip.Tip="{l:T EventsPrev}">
            <Panel>
              <PathIcon Data="{x:Static icons:UiIcons.Back}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Button>
          <TextBlock Text="{Binding PageText}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="16" LetterSpacing="1"
                     VerticalAlignment="Center" MinWidth="110" TextAlignment="Center" />
          <Button Classes="tab round" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}" ToolTip.Tip="{l:T EventsNext}">
            <Panel>
              <PathIcon Data="{x:Static icons:UiIcons.Forward}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Button>
          <Button Classes="ghost" Content="{l:T EventsNowButton}" Command="{Binding NowPageCommand}" IsEnabled="{Binding CanPrevPage}" Margin="6,0,0,0" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="#E6101216" BorderBrush="{StaticResource ArcLine}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <!-- nagłówek godzin -->
          <Border Background="{StaticResource ArcBlack}" BorderBrush="{StaticResource ArcLine}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="190,*">
              <TextBlock Text="{l:T EventsMapColumn}" Classes="label" Margin="10,10" VerticalAlignment="Center" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Hours}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EventHourViewModel">
                    <Border BorderBrush="{StaticResource ArcLine}" BorderThickness="1,0,0,0" Padding="10,10">
                      <TextBlock Text="{Binding Label}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15" LetterSpacing="1"
                                 Foreground="{Binding Foreground}" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <!-- wiersze map -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EventRowViewModel">
                <Border BorderBrush="#191C21" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="190,*">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,6,0" VerticalAlignment="Center">
                      <Border Width="4" Height="28" CornerRadius="2" Background="{Binding Tint}" />
                      <TextBlock Text="{Binding Map}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="168" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventCellViewModel">
                          <Border Classes="evcell" Background="{Binding Background}" BorderBrush="#1A1D22" BorderThickness="1,0,0,0" Padding="6">
                            <ItemsControl ItemsSource="{Binding Events}" VerticalAlignment="Center">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EventChipViewModel">
                                  <Button Classes="evchip" Command="{Binding OpenMapCommand}" ToolTip.Tip="{Binding Tooltip}" Opacity="{Binding Opacity}">
                                    <Border Background="{Binding Fill}" BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0" CornerRadius="6" Padding="8,6">
                                      <Grid ColumnDefinitions="Auto,*">
                                        <c:RemoteImage Url="{Binding IconUrl}" DecodeWidth="56" Width="26" Height="26" Margin="0,0,8,0"
                                                       IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                      </Grid>
                                    </Border>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
