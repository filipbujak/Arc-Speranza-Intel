<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ArcSperanzaIntel.App.Localization"
             xmlns:vm="using:ArcSperanzaIntel.App.ViewModels"
             xmlns:icons="using:ArcSperanzaIntel.App.Icons"
             xmlns:c="using:ArcSperanzaIntel.App.Controls"
             x:Class="ArcSperanzaIntel.App.Views.WantedItemsPanel"
             x:DataType="vm:WantedItemsViewModel"
             Width="320">

  <Border Classes="overlay">
    <StackPanel>
      <!-- nagłówek: klik (lewy lub prawy przycisk) rozwija / chowa -->
      <Button x:Name="Header" Classes="flat" Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Padding="12,10" Foreground="{StaticResource ArcText}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <PathIcon Data="{x:Static icons:UiIcons.Bag}" Width="16" Height="16" Foreground="{StaticResource ArcYellow}" />
          <TextBlock Grid.Column="1" Text="{l:T WantedTitle}" Classes="label" Foreground="{StaticResource ArcText}"
                     Margin="10,0" VerticalAlignment="Center" />
          <Border Grid.Column="2" Background="{StaticResource ArcYellow}" CornerRadius="2" Padding="7,1"
                  IsVisible="{Binding !IsEmpty}">
            <TextBlock Text="{Binding TotalItems}" Foreground="#111111" FontWeight="Bold" FontSize="12" />
          </Border>
          <Panel Grid.Column="3" Margin="10,0,0,0">
            <PathIcon Data="{x:Static icons:UiIcons.ChevronUp}" Width="14" Height="14" IsVisible="{Binding IsExpanded}" />
            <PathIcon Data="{x:Static icons:UiIcons.ChevronDown}" Width="14" Height="14" IsVisible="{Binding IsCollapsed}" />
          </Panel>
        </Grid>
      </Button>

      <!-- treść: płynne rozwijanie przez animację MaxHeight -->
      <Border MaxHeight="{Binding BodyMaxHeight}" ClipToBounds="True">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="MaxHeight" Duration="0:0:0.28" Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>
        <StackPanel>
          <Border Classes="divider" />
          <StackPanel Orientation="Horizontal" Spacing="14" Margin="14,8,14,2">
            <CheckBox Content="{l:T TrackQuests}" IsChecked="{Binding TrackQuests}" FontSize="12" MinHeight="24" />
            <CheckBox Content="{l:T TrackStations}" IsChecked="{Binding TrackStations}" FontSize="12" MinHeight="24" />
          </StackPanel>
          <TextBlock Text="{l:T WantedEmpty}"
                     Classes="dim small" TextWrapping="Wrap" Margin="14,12" IsVisible="{Binding IsEmpty}" />
          <ScrollViewer MaxHeight="600" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,4,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WantedGroupViewModel">
                  <StackPanel Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="6,0" Opacity="{Binding TitleOpacity}">
                      <Button Classes="flat" Command="{Binding ToggleCollapsedCommand}" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left" Padding="6,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{x:Static icons:UiIcons.ChevronDown}" Width="10" Height="10" IsVisible="{Binding IsOpen}" />
                          <PathIcon Data="{x:Static icons:UiIcons.ChevronRight}" Width="10" Height="10" IsVisible="{Binding IsCollapsed}" />
                          <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontWeight="SemiBold" FontSize="13"
                                     TextTrimming="CharacterEllipsis" MaxWidth="210" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1" Classes="flat" Padding="6,4" IsVisible="{Binding CanUntrack}"
                              Command="{Binding ToggleTrackedCommand}" ToolTip.Tip="{Binding TrackTip}">
                        <Panel>
                          <PathIcon Data="{x:Static icons:UiIcons.Eye}" Width="13" Height="13" IsVisible="{Binding IsTracked}" />
                          <PathIcon Data="{x:Static icons:UiIcons.EyeOff}" Width="13" Height="13" IsVisible="{Binding IsUntracked}" />
                        </Panel>
                      </Button>
                      <Button Grid.Column="2" Classes="flat" Padding="6,4" IsVisible="{Binding CanGoTo}"
                              Command="{Binding OpenQuestCommand}" ToolTip.Tip="{l:T ShowSource}">
                        <PathIcon Data="{x:Static icons:UiIcons.Goto}" Width="13" Height="13" />
                      </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsOpen}" Margin="12,0,8,4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WantedItemViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                            <Button Classes="flat" Padding="0" Command="{Binding OpenCommand}" ToolTip.Tip="{l:T ShowInItems}">
                              <Border Width="36" Height="36" Background="{StaticResource ArcBlack}" BorderBrush="{Binding RarityBrush}"
                                      BorderThickness="0,0,0,2" CornerRadius="2">
                                <c:RemoteImage Url="{Binding IconUrl}" IsBlueprint="{Binding IsBlueprint}" DecodeWidth="72" Margin="3" />
                              </Border>
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,6,0"
                                       TextTrimming="CharacterEllipsis" FontSize="13" />
                            <TextBlock Grid.Column="2" Text="{Binding QuantityText}" VerticalAlignment="Center"
                                       Foreground="{StaticResource ArcYellow}" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" IsVisible="{Binding IsManual}">
                              <Button Classes="flat" Padding="4" Command="{Binding MinusCommand}" ToolTip.Tip="{l:T Less}">
                                <PathIcon Data="{x:Static icons:UiIcons.Minus}" Width="11" Height="11" />
                              </Button>
                              <Button Classes="flat" Padding="4" Command="{Binding PlusCommand}" ToolTip.Tip="{l:T More}">
                                <PathIcon Data="{x:Static icons:UiIcons.Plus}" Width="11" Height="11" />
                              </Button>
                              <Button Classes="flat" Padding="4" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:T RemoveFromWanted}">
                                <PathIcon Data="{x:Static icons:UiIcons.Close}" Width="11" Height="11" />
                              </Button>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
