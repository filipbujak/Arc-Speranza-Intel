<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArcSperanzaIntel.App.ViewModels"
        xmlns:c="using:ArcSperanzaIntel.App.Controls"
        x:Class="ArcSperanzaIntel.App.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="ARC Speranza Intel — overlay"
        Icon="/Assets/app.ico"
        Width="300" Height="420" MinWidth="200" MinHeight="140"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="True"
        Background="Transparent"
        WindowStartupLocation="Manual">

  <Border CornerRadius="10" Background="#E00B0C0E" BorderBrush="#40FFC72C" BorderThickness="1"
          Opacity="{Binding PanelOpacity}" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">

      <!-- pasek: chwyć i przeciągnij -->
      <Border x:Name="DragBar" Background="#14FFFFFF" Padding="12,8" Cursor="SizeAll">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <c:AppLogo Height="18" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                     FontSize="15" LetterSpacing="2" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{StaticResource ArcYellow}" FontWeight="Bold"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Foreground="{StaticResource ArcMuted}" TextWrapping="Wrap"
                 Margin="14" IsVisible="{Binding IsEmpty}" />

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,14">
        <ItemsControl ItemsSource="{Binding Items}" Margin="8,2">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverlayItemViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3" ToolTip.Tip="{Binding Sources}">
                <c:ItemTile Width="38" Height="38" Url="{Binding IconUrl}" Accent="{Binding RarityBrush}"
                            IsBlueprint="{Binding IsBlueprint}" DecodeWidth="76" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontSize="13" />
                <TextBlock Grid.Column="2" Text="{Binding QuantityText}" Foreground="{StaticResource ArcYellow}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- uchwyt do zmiany rozmiaru -->
      <Border x:Name="ResizeGrip" Grid.Row="1" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomRightCorner">
        <Path Data="M 14,4 L 4,14 M 14,9 L 9,14" Stroke="{StaticResource ArcMuted}" StrokeThickness="1.2" />
      </Border>
    </Grid>
  </Border>
</Window>
